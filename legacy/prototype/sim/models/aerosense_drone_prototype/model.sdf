<?xml version="1.0"?>
<!--
  Aero Sense airframe: stock ArduPilot iris + a payload with
    - RGB-D camera  (stands in for RGB + stereo depth)
    - LWIR thermal camera (L16, 0.01 K per count)
  Both look forward-down at 55 deg (0.9599 rad) and share the same FOV so their
  pixels line up after scaling. The tilt must match CAMERA_TILT_RAD in aerosense/geo.py.
-->
<sdf version="1.9">
  <model name="aerosense_drone">
    <include merge="true">
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <link name="payload_link">
      <pose>0.12 0 -0.03 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <visual name="payload_visual">
        <geometry><box><size>0.05 0.09 0.04</size></box></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <sensor name="rgbd" type="rgbd_camera">
        <pose>0 0 0 0 0.9599 0</pose>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.3</near><far>150</far></clip>
          <depth_camera><clip><near>0.3</near><far>150</far></clip></depth_camera>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>rgbd</topic>
      </sensor>

      <sensor name="thermal" type="thermal">
        <pose>0 0 0 0 0.9599 0</pose>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>320</width><height>240</height><format>L16</format></image>
          <clip><near>0.3</near><far>150</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>thermal/image</topic>
        <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>600</max_temp>
          <resolution>0.01</resolution>
        </plugin>
      </sensor>
    </link>

    <joint name="payload_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>payload_link</child>
    </joint>
  </model>
</sdf>
