<?xml version="1.0"?>
<!-- Rubble spread (~3 x 5 x 0.2 m): the debris_3_1 mesh from gazebo_models_worlds_collection
     scaled x4, in a darker debris colour. ponytail: colour, not texture, and visual only; see
     aero_sense_rubble_a. -->
<sdf version="1.9">
  <model name="aero_sense_rubble_b">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><mesh><uri>model://debris_3_1/meshes/debris_3_1.dae</uri><scale>4 4 4</scale></mesh></geometry>
        <material><ambient>0.22 0.20 0.18 1</ambient><diffuse>0.22 0.20 0.18 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
