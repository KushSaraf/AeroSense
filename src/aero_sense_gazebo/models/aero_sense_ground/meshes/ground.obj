# Aero Sense ground: one 440 x 360 m quad (model origin at its centre). UVs run past 1 so the
# texture repeats every 8 m instead of stretching once over the whole world.
v -220 -180 0
v 220 -180 0
v 220 180 0
v -220 180 0
vt 0 0
vt 55 0
vt 55 45
vt 0 45
vn 0 0 1
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
