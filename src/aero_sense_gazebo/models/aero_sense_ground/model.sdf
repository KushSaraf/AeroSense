<?xml version="1.0"?>
<!-- Ground: a tiled quad (meshes/ground.obj) with the collection's grass texture (model://<repo>/...
     resolves because reference/ is on the resource path; a bare filename would be looked up
     beside this file and silently not load). Sun-warmed ground at 298 K in LWIR. Collision is
     an infinite plane.
     The texture must have no alpha channel: Harmonic reads alpha as transparency, and Classic's
     *_diffusespecular.png pack specular there, which turns the ground into a see-through sheet. -->
<sdf version="1.9">
  <model name="aero_sense_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>440 360</size></plane></geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_ground/meshes/ground.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://gazebo_models_worlds_collection-master/models/cyberzoo/cyberzoo_floor/grass_green.png</albedo_map>
            <roughness>0.95</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298</temperature>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
