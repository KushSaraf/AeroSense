<?xml version="1.0"?>
<!-- Ground, generated by tools/layout_world.py in world coordinates (hence each visual's pose
     undoing the include's y -20), all dipping into the S2 flood valley (tools/flood_valley.py):
     grass farmland under everything with the collection's grass texture, packed bare earth under the
     society and concrete dust around S1's collapses (298 K, like the ground), and wet mud across the
     flood valley and just beyond its shoreline (294 K, cooler, still far below body heat).
     The grass texture resolves as model://<repo>/... because reference/ is on the resource path (a
     bare filename would be looked up beside this file and silently not load), and must have no
     alpha channel: Harmonic reads alpha as transparency. Collision is an infinite plane at the plain's
     level; nothing lands in the valley. -->
<sdf version="1.9">
  <model name="aero_sense_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>440 360</size></plane></geometry>
      </collision>
      <visual name="visual">
        <pose>0 20 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_ground/meshes/ground.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://gazebo_models_worlds_collection-master/models/cyberzoo/cyberzoo_floor/grass_green.png</albedo_map>
            <roughness>0.95</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298</temperature>
        </plugin>
      </visual>
      <visual name="earth">
        <pose>0 20 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_ground/meshes/earth.obj</uri></mesh></geometry>
        <material>
          <ambient>0.50 0.44 0.35 1</ambient><diffuse>0.50 0.44 0.35 1</diffuse>
          <pbr><metal><roughness>0.95</roughness><metalness>0</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298</temperature>
        </plugin>
      </visual>
      <visual name="dust">
        <pose>0 20 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_ground/meshes/dust.obj</uri></mesh></geometry>
        <material>
          <ambient>0.66 0.63 0.58 1</ambient><diffuse>0.66 0.63 0.58 1</diffuse>
          <pbr><metal><roughness>0.95</roughness><metalness>0</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298</temperature>
        </plugin>
      </visual>
      <visual name="mud">
        <pose>0 20 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_ground/meshes/mud.obj</uri></mesh></geometry>
        <material>
          <ambient>0.24 0.19 0.14 1</ambient><diffuse>0.24 0.19 0.14 1</diffuse>
          <pbr><metal><roughness>0.6</roughness><metalness>0</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>294</temperature>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
