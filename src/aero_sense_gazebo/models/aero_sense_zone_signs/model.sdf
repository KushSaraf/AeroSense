<?xml version="1.0"?>
<!-- Wayfinding, so someone who has never seen the world can tell what is where. Included at the
     world origin, so every pose below is a world position.
     Signboards stand beside the spine road facing the command base; zone names are painted on the
     grass south of each sector and beside the pad; the yellow outlines are exactly the areas the
     missions search (aero_sense_mission.mission_manager.SCENARIO_AREAS, tested). Everything sits
     outside the search areas or at ambient temperature, below the thermal detector's threshold,
     so none of it can be mistaken for a casualty.
     Red outlines mark where the network is down (aero_sense_mission.comms.NO_NETWORK_ZONES,
     tested), raised just above the road surface, with NO NETWORK painted north of the sector. Label meshes: tools/make_label_box.py. -->
<sdf version="1.9">
  <model name="aero_sense_zone_signs">
    <static>true</static>
    <link name="link">
      <visual name="board_earthquake">
        <pose>-22 -10 4.25 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_zone_signs/meshes/board_earthquake.glb</uri></mesh></geometry>
      </visual>
      <collision name="board_earthquake_collision">
        <pose>-22 -10 4.25 0 0 0</pose>
        <geometry><box><size>16 0.25 3.5</size></box></geometry>
      </collision>
      <visual name="post_earthquake_l">
        <pose>-28.5 -9.7 3.0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><cylinder><radius>0.15</radius><length>6.0</length></cylinder></geometry>
        <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material>
      </visual>
      <visual name="post_earthquake_r">
