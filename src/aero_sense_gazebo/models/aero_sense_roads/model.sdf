<?xml version="1.0"?>
<!-- Road network, generated by tools/layout_world.py in world coordinates: asphalt roads (meshes/roads.obj) with the DARPA SubT Asphalt01 PBR set
     (albedo, normal, roughness; model://<repo>/... resolves because reference/ is on the
     resource path). Asphalt reads 301 K in LWIR, warmer than the 298 K ground but a clear
     two quantisation steps below body heat (306-310 K), so casualties stay separable. Flat and a couple of cm up: no collision, the ground plane carries. -->
<sdf version="1.9">
  <model name="aero_sense_roads">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_roads/meshes/roads.obj</uri></mesh></geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <pbr><metal>
            <albedo_map>model://darpa_subt_worlds-main/materials/textures/Asphalt01_Albedo.jpg</albedo_map>
            <normal_map>model://darpa_subt_worlds-main/materials/textures/Asphalt01_Normal.jpg</normal_map>
            <roughness_map>model://darpa_subt_worlds-main/materials/textures/Asphalt01_Roughness.jpg</roughness_map>
            <metalness>0</metalness>
          </metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>301</temperature>
        </plugin>
      </visual>
      <!-- Concrete galis, 3-4 m wide: sun-warmed like the asphalt, a touch cooler -->
      <visual name="lanes">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_roads/meshes/lanes.obj</uri></mesh></geometry>
        <material>
          <ambient>0.58 0.56 0.52 1</ambient><diffuse>0.58 0.56 0.52 1</diffuse>
          <pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>300</temperature>
        </plugin>
      </visual>
      <!-- Village dirt tracks, mostly under the flood -->
      <visual name="tracks">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://aero_sense_roads/meshes/tracks.obj</uri></mesh></geometry>
        <material>
          <ambient>0.42 0.34 0.25 1</ambient><diffuse>0.42 0.34 0.25 1</diffuse>
          <pbr><metal><roughness>0.9</roughness><metalness>0</metalness></metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>297</temperature>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
