<?xml version="1.0"?>
<!-- The landslide sector's relief: a 200 x 200 m ridge rising 25 m north of the city, with the
     failure scar gouged down its face (tools/make_terrain.py). Its south edge is at zero height,
     so it meets the flat plain the city stands on and nothing there has to move.

     A mesh, not a <heightmap>: heightmaps render for physics and the GUI but stay invisible to
     the camera sensors, which would have left the drone flying at a ridge it could not see.
     Grass below, bare rubble above, and a coarse collision surface because mesh collision costs
     per triangle. -->
<sdf version="1.9">
  <model name="aero_sense_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><mesh><uri>model://aero_sense_terrain/meshes/terrain_collision.obj</uri></mesh></geometry>
      </collision>
      <visual name="slope">
        <geometry><mesh><uri>model://aero_sense_terrain/meshes/terrain_slope.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://gazebo_models_worlds_collection-master/models/cyberzoo/cyberzoo_floor/grass_green.png</albedo_map>
            <roughness>0.95</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>297</temperature>
        </plugin>
      </visual>
      <visual name="scar">
        <geometry><mesh><uri>model://aero_sense_terrain/meshes/terrain_scar.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://tdf_gazebo-main/models/collapsed_industrial/materials/textures/rubble_diffuse.jpg</albedo_map>
            <roughness>1.0</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>299</temperature>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
