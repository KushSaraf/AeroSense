<?xml version="1.0"?>
<!-- Broken wall slabs (~3.4 x 5.3 m): the wall_debris mesh from gazebo_models_worlds_collection
     scaled x4, in a plaster-dust grey. ponytail: colour, not texture, and visual only; see
     aero_sense_rubble_a. -->
<sdf version="1.9">
  <model name="aero_sense_rubble_slab">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><mesh><uri>model://wall_debris/meshes/wall_debris.dae</uri><scale>4 4 4</scale></mesh></geometry>
        <material><ambient>0.33 0.31 0.28 1</ambient><diffuse>0.33 0.31 0.28 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
