<?xml version="1.0" ?>
<!--
  Aero Sense disaster zone: one world, five sectors (~400 x 300 m). Gazebo ENU: x = east,
  y = north; the world origin is the map origin. Drones spawn on the command-base pad.

              N                     (no double hyphens: they end an XML comment)
   +==============================+   y +200
   | S4 LANDSLIDE  (ridge + scar) |
   +===============+==============+   y +100
   | S1 EARTHQUAKE | S2 FLOOD     |
   +===============+==============+   y 0
   | S3 FIRE       | S5 CHEMICAL  |
   |      (ph. 14) |      (ph. 16)|
   +===============+==============+   y -100
     x -200          0          x +200        command base (0, -110)

  S1 earthquake (x -200..0, y 0..100): dense terraced blocks on a 20 x 19 m pitch, leaving
    4-6 m lanes between houses, plus the collapsed industrial hall (24 m), fire and police
    stations, rubble, broken walls, trapped vehicles, a 44 m radio mast at (-40, 60) and a
    10 m water tower. The masts and the hall stand above the 15-20 m search altitude, and the
    lanes are narrow enough that casualties in them are only visible from steep angles.
    No trees: the tdf oak/pine alpha-cutout leaves render as black blobs in Harmonic.
  S2 flood (x 0..200, y 0..100): a village under 0.6 m of standing water, laid over the ground
    so buildings and vehicles are submerged to that depth. Casualties are in the water, which is
    colder than the ground in LWIR, not warmer.
  Assets come from reference/ (gitignored): tdf_gazebo and gazebo_models_worlds_collection.
  For people watching: signboards and zone names point to each sector, the yellow outlines are the
  areas the missions search, and farmland runs to the horizon (aero_sense_zone_signs, _surroundings).
-->
<sdf version="1.9">
  <world name="aero_sense_disaster">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <scene>
      <ambient>0.7 0.7 0.7</ambient>
      <background>0.7 0.75 0.8</background>
      <sky></sky>
    </scene>

    <!-- Everything without its own Thermal plugin reads at ambient temperature. -->
    <atmosphere type="adiabatic">
      <temperature>293</temperature>
    </atmosphere>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Drones spawn here (read by aero_sense_bringup/worlds.py): pad surface, nose north. -->
    <frame name="drone_spawn">
      <pose>0 -110 0.1 0 0 1.5708</pose>
    </frame>

    <!-- Tiled dirt ground and the asphalt road network (spine x = 0, avenues y = 0 and 100,
         S1 streets x = -100 and y = 50); see aero_sense_gazebo/models. -->
    <include><name>ground</name><pose>0 -20 0 0 0 0</pose><uri>model://aero_sense_ground</uri></include>
    <include><name>roads</name><pose>0 0 0 0 0 0</pose><uri>model://aero_sense_roads</uri></include>
    <include><name>surroundings</name><pose>0 0 0 0 0 0</pose><uri>model://aero_sense_surroundings</uri></include>
    <!-- Signs, zone names and search-area outlines for people watching (aero_sense_zone_signs). -->
    <include><name>zone_signs</name><pose>0 0 0 0 0 0</pose><uri>model://aero_sense_zone_signs</uri></include>

    <!-- Command base: landing pad with an H marking, and the operations tent. -->
    <model name="command_base">
      <static>true</static>
      <pose>0 -110 0 0 0 0</pose>
      <link name="link">
        <collision name="pad_collision">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>12 12 0.1</size></box></geometry>
        </collision>
        <visual name="pad">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>12 12 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.55 0.55 0.52 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>300</temperature>
          </plugin>
        </visual>
        <visual name="h_left">
          <pose>-2 0 0.101 0 0 0</pose>
          <geometry><box><size>0.6 5 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_right">
          <pose>2 0 0.101 0 0 0</pose>
          <geometry><box><size>0.6 5 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_bar">
          <pose>0 0 0.101 0 0 0</pose>
          <geometry><box><size>4 0.6 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <collision name="tent_collision">
          <pose>14 -4 1.5 0 0 0</pose>
          <geometry><box><size>6 4 3</size></box></geometry>
        </collision>
        <visual name="tent">
          <pose>14 -4 1.5 0 0 0</pose>
          <geometry><box><size>6 4 3</size></box></geometry>
          <material><ambient>0.2 0.35 0.2 1</ambient><diffuse>0.2 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ S1 EARTHQUAKE ============ -->
    <!-- Dense old-town blocks: 16 x 13 m houses on a 20 x 19 m pitch, so the lanes between them
         are 4-6 m wide. Casualties lie in those lanes, where a drone has to look almost straight
         down to see them and the walls block the low, slanted views. -->
    <include><name>s1_house_1</name><pose degrees="true">-186 12 0 0 0 8</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_2</name><pose degrees="true">-166 12 0 0 0 -5</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_3</name><pose degrees="true">-146 12 0 0 0 12</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_4</name><pose degrees="true">-126 12 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_5</name><pose degrees="true">-186 31 0 0 0 -10</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_6</name><pose degrees="true">-166 31 0 0 0 6</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_7</name><pose degrees="true">-146 31 0 0 0 -3</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_8</name><pose degrees="true">-126 31 0 0 0 15</pose><uri>model://collapsed_house</uri></include>

    <!-- Market block: the collapsed industrial hall and its neighbours -->
    <include><name>s1_industrial</name><pose>-60 25 0 0 0 0</pose><uri>model://collapsed_industrial</uri></include>
    <include><name>s1_house_9</name><pose degrees="true">-95 13 0 0 0 20</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_10</name><pose degrees="true">-95 36 0 0 0 -8</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_11</name><pose degrees="true">-28 13 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_12</name><pose degrees="true">-28 36 0 0 0 10</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_water_tower</name><pose>-12 25 0 0 0 0</pose><uri>model://water_tower</uri></include>

    <!-- North-west block: fire station and terraced houses -->
    <include><name>s1_fire_station</name><pose degrees="true">-160 75 0 0 0 90</pose><uri>model://collapsed_fire_station</uri></include>
    <include><name>s1_house_13</name><pose degrees="true">-188 62 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_14</name><pose degrees="true">-188 86 0 0 0 8</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_15</name><pose degrees="true">-136 62 0 0 0 -12</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_16</name><pose degrees="true">-136 86 0 0 0 4</pose><uri>model://collapsed_house</uri></include>

    <!-- North-east block: police station, the radio mast and more terraces -->
    <include><name>s1_police_station</name><pose>-70 78 0 0 0 0</pose><uri>model://collapsed_police_station</uri></include>
    <include><name>s1_radio_mast</name><pose>-40 60 0 0 0 0</pose><uri>model://radio_tower</uri></include>
    <include><name>s1_house_17</name><pose degrees="true">-96 64 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_18</name><pose degrees="true">-96 90 0 0 0 -6</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_19</name><pose degrees="true">-20 64 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s1_house_20</name><pose degrees="true">-20 90 0 0 0 -6</pose><uri>model://collapsed_house</uri></include>

    <!-- Rubble spilling into the lanes, broken walls, and the cordon -->
    <include><name>s1_rubble_1</name><pose degrees="true">-176 40 0 0 0 0</pose><uri>model://aero_sense_rubble_a</uri></include>
    <include><name>s1_rubble_2</name><pose degrees="true">-116 21 0 0 0 40</pose><uri>model://aero_sense_rubble_b</uri></include>
    <include><name>s1_rubble_3</name><pose degrees="true">-85 25 0 0 0 30</pose><uri>model://aero_sense_rubble_slab</uri></include>
    <include><name>s1_rubble_4</name><pose degrees="true">-44 42 0 0 0 120</pose><uri>model://aero_sense_rubble_a</uri></include>
    <include><name>s1_rubble_5</name><pose>-150 60 0 0 0 0</pose><uri>model://aero_sense_rubble_b</uri></include>
    <include><name>s1_rubble_6</name><pose degrees="true">-55 92 0 0 0 70</pose><uri>model://aero_sense_rubble_slab</uri></include>
    <include><name>s1_wall_1</name><pose degrees="true">-156 42 0 0 0 90</pose><uri>model://aero_sense_broken_wall</uri></include>
    <include><name>s1_wall_2</name><pose>-170 95 0 0 0 0</pose><uri>model://aero_sense_broken_wall</uri></include>
    <include><name>s1_cordon_1</name><pose degrees="true">-8 48 0 0 0 90</pose><uri>model://jersey_barrier</uri></include>
    <include><name>s1_cordon_2</name><pose degrees="true">-8 52 0 0 0 90</pose><uri>model://jersey_barrier</uri></include>
    <include><name>s1_cordon_3</name><pose>-102 6 0 0 0 0</pose><uri>model://jersey_barrier</uri></include>
    <include><name>s1_barrier_shoved</name><pose degrees="true">-130 50.5 0 0 0 20</pose><uri>model://jersey_barrier</uri></include>

    <!-- Vehicles trapped in the lanes and on the streets -->
    <include><name>s1_bus</name><pose degrees="true">-150 50 0 0 0 97</pose><uri>model://bus</uri></include>
    <include><name>s1_pickup_1</name><pose degrees="true">-156 21 0 0 0 92</pose><uri>model://pickup</uri></include>
    <include><name>s1_pickup_2</name><pose degrees="true">-120 1 0 0 0 95</pose><uri>model://pickup</uri></include>
    <include><name>s1_hatchback_1</name><pose>-100 70 0 0 0 0</pose><uri>model://hatchback</uri></include>
    <include><name>s1_hatchback_2</name><pose degrees="true">-98 30 0 0 0 10</pose><uri>model://hatchback</uri></include>

    <!-- ============ S2 FLOOD ============ -->
    <!-- A village standing in 0.6 m of water: the buildings and vehicles sit on the ground as
         usual and the flood surface is laid over them, so everything low is submerged. The water
         reads 291 K in LWIR, colder than the 298 K ground, so a body in it stands out the other
         way round from a body on dry land. -->
    <include><name>s2_house_1</name><pose degrees="true">40 20 0 0 0 10</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_2</name><pose degrees="true">70 20 0 0 0 -5</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_3</name><pose degrees="true">40 45 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_4</name><pose degrees="true">70 45 0 0 0 12</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_5</name><pose degrees="true">130 25 0 0 0 0</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_6</name><pose degrees="true">160 25 0 0 0 8</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_7</name><pose degrees="true">130 55 0 0 0 -6</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_house_8</name><pose degrees="true">160 55 0 0 0 3</pose><uri>model://collapsed_house</uri></include>
    <include><name>s2_water_tower</name><pose>100 78 0 0 0 0</pose><uri>model://water_tower</uri></include>
    <include><name>s2_pickup_1</name><pose degrees="true">55 12 0 0 0 90</pose><uri>model://pickup</uri></include>
    <include><name>s2_hatchback_1</name><pose degrees="true">145 40 0 0 0 15</pose><uri>model://hatchback</uri></include>
    <include><name>s2_bus</name><pose degrees="true">100 8 0 0 0 5</pose><uri>model://bus</uri></include>
    <include><name>s2_debris_1</name><pose degrees="true">60 33 0.4 0 0 25</pose><uri>model://aero_sense_rubble_a</uri></include>
    <include><name>s2_debris_2</name><pose degrees="true">120 66 0.4 0 0 110</pose><uri>model://aero_sense_rubble_slab</uri></include>
    <include><name>s2_cordon_1</name><pose degrees="true">8 30 0 0 0 90</pose><uri>model://jersey_barrier</uri></include>
    <include><name>s2_cordon_2</name><pose degrees="true">8 34 0 0 0 90</pose><uri>model://jersey_barrier</uri></include>
    <!-- laid over the sector last: everything above is already in place beneath it -->
    <include><name>flood_water</name><pose>0 0 0.6 0 0 0</pose><uri>model://aero_sense_flood_water</uri></include>

  </world>
</sdf>
