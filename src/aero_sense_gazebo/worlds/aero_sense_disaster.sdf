<?xml version="1.0" ?>
<!--
  Aero Sense disaster zone: one world, five sectors (~400 x 300 m). Gazebo ENU: x = east,
  y = north; the world origin is the map origin. Drones spawn on the command-base pad.

              N                     (no double hyphens: they end an XML comment)
   +===============+==============+   y +100
   | S1 EARTHQUAKE | S2 FLOOD     |
   +===============+==============+   y 0
   | S3 FIRE       | S5 CHEMICAL  |
   |      (ph. 14) |      (ph. 16)|
   +===============+==============+   y -100
     x -200          0          x +200        command base (0, -110)

  S1 earthquake (x -200..0, y 0..100) and S2 flood (x 0..200, y 0..100) are one Indian residential
    society, laid out by tools/layout_world.py with buildings from tools/make_buildings.py: RCC
    houses, shops and G+3 apartment blocks in pastel paint with rooftop Sintex tanks, packed along
    winding asphalt roads, narrow concrete galis and village dirt tracks, facing the street, with
    electric poles and parked vehicles. Nothing is on a grid or straight.
  S1: many buildings pancaked or slumped, concrete dust around them, leaning poles, and the
    hand-placed landmarks: collapsed industrial hall (24 m), fire and police stations, a 44 m
    radio mast at (-40, 60) and a 10 m water tower. The mast and the hall stand above the 15-20 m
    search altitude; galis are 3-4 m wide, so casualties in them are only visible from steep
    angles. No trees: the tdf oak/pine alpha-cutout leaves render as black blobs in Harmonic.
  S2: the village under 0.6 m of standing water with a ragged shoreline and a wet mud fringe, laid
    over the ground so buildings and vehicles are submerged to that depth. Casualties are in the
    water, which is colder than the ground in LWIR, not warmer.
  Assets come from reference/ (gitignored): tdf_gazebo and gazebo_models_worlds_collection.
  For people watching: signboards and zone names point to each sector, the yellow outlines are the
  areas the missions search, and farmland runs to the horizon (aero_sense_zone_signs, _surroundings).
-->
<sdf version="1.9">
  <world name="aero_sense_disaster">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <scene>
      <ambient>0.7 0.7 0.7</ambient>
      <background>0.7 0.75 0.8</background>
      <sky></sky>
    </scene>

    <!-- Everything without its own Thermal plugin reads at ambient temperature. -->
    <atmosphere type="adiabatic">
      <temperature>293</temperature>
    </atmosphere>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Drones spawn here (read by aero_sense_bringup/worlds.py): pad surface, nose north. -->
    <frame name="drone_spawn">
      <pose>0 -110 0.1 0 0 1.5708</pose>
    </frame>

    <!-- Ground (grass, dust and mud patches) and the road network: winding asphalt roads, concrete
         galis and dirt tracks, generated by tools/layout_world.py; see aero_sense_gazebo/models. -->
    <include><name>ground</name><pose>0 -20 0 0 0 0</pose><uri>model://aero_sense_ground</uri></include>
    <include><name>roads</name><pose>0 0 0 0 0 0</pose><uri>model://aero_sense_roads</uri></include>
    <include><name>surroundings</name><pose>0 0 0 0 0 0</pose><uri>model://aero_sense_surroundings</uri></include>
    <!-- Signs, zone names and search-area outlines for people watching (aero_sense_zone_signs). -->
    <include><name>zone_signs</name><pose>0 0 0 0 0 0</pose><uri>model://aero_sense_zone_signs</uri></include>

    <!-- Command base: landing pad with an H marking, and the operations tent. -->
    <model name="command_base">
      <static>true</static>
      <pose>0 -110 0 0 0 0</pose>
      <link name="link">
        <collision name="pad_collision">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>12 12 0.1</size></box></geometry>
        </collision>
        <visual name="pad">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>12 12 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.55 0.55 0.52 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>300</temperature>
          </plugin>
        </visual>
        <visual name="h_left">
          <pose>-2 0 0.101 0 0 0</pose>
          <geometry><box><size>0.6 5 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_right">
          <pose>2 0 0.101 0 0 0</pose>
          <geometry><box><size>0.6 5 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_bar">
          <pose>0 0 0.101 0 0 0</pose>
          <geometry><box><size>4 0.6 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <collision name="tent_collision">
          <pose>14 -4 1.5 0 0 0</pose>
          <geometry><box><size>6 4 3</size></box></geometry>
        </collision>
        <visual name="tent">
          <pose>14 -4 1.5 0 0 0</pose>
          <geometry><box><size>6 4 3</size></box></geometry>
          <material><ambient>0.2 0.35 0.2 1</ambient><diffuse>0.2 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ LANDMARKS (hand placed) ============ -->
    <!-- S1: the collapsed industrial hall, fire and police stations, a 44 m radio mast and a water
         tower, which stand above the 15-20 m search altitude or mark the blocks. -->
    <include><name>s1_industrial</name><pose>-60 25 0 0 0 0</pose><uri>model://collapsed_industrial</uri></include>
    <include><name>s1_water_tower</name><pose>-12 25 0 0 0 0</pose><uri>model://water_tower</uri></include>
    <include><name>s1_fire_station</name><pose degrees="true">-160 75 0 0 0 90</pose><uri>model://collapsed_fire_station</uri></include>
    <include><name>s1_police_station</name><pose>-70 78 0 0 0 0</pose><uri>model://collapsed_police_station</uri></include>
    <include><name>s1_radio_mast</name><pose>-40 60 0 0 0 0</pose><uri>model://radio_tower</uri></include>
    <!-- S2: the village water tank -->
    <include><name>s2_water_tower</name><pose>100 78 0 0 0 0</pose><uri>model://water_tower</uri></include>

    <!-- ============ THE SOCIETY (generated) ============ -->
    <!-- S1 earthquake and S2 flood as an Indian residential society: houses, shops and apartment
         blocks packed along winding roads and galis and facing them, many of S1's pancaked or
         slumped, electric poles (some leaning), parked vehicles and cordons. Regenerate with
         tools/layout_world.py, which keeps every casualty clear, or inside on purpose. -->
    <!-- GENERATED by tools/layout_world.py: edits between these markers are overwritten -->
    <include><name>s1_trapped_v13</name><pose>-164.00 15.50 0 0.000 0.000 -1.571</pose><uri>model://aero_sense_building_collapsed_pancake_2f</uri></include>
    <include><name>s1_trapped_v14</name><pose>-95.50 37.00 0 0.000 0.000 0.000</pose><uri>model://aero_sense_building_collapsed_pancake_3f</uri></include>
    <include><name>s1_trapped_v15</name><pose>-91.50 63.00 0 0.000 0.000 3.142</pose><uri>model://aero_sense_building_collapsed_pancake_3f</uri></include>
    <include><name>s1_bus</name><pose>-85.63 47.73 0 0.000 0.000 1.210</pose><uri>model://bus</uri></include>
    <include><name>s1_pickup_1</name><pose>-103.86 87.06 0 0.000 0.000 2.701</pose><uri>model://pickup</uri></include>
    <include><name>s1_pickup_2</name><pose>-75.96 13.75 0 0.000 0.000 3.806</pose><uri>model://pickup</uri></include>
    <include><name>s1_hatchback_1</name><pose>-162.84 44.44 0 0.000 0.000 -2.044</pose><uri>model://hatchback</uri></include>
    <include><name>s1_hatchback_2</name><pose>-140.31 94.04 0 0.000 0.000 2.761</pose><uri>model://hatchback</uri></include>
    <include><name>s2_bus</name><pose>92.53 25.23 0 0.000 0.000 -1.077</pose><uri>model://bus</uri></include>
    <include><name>s2_pickup_1</name><pose>47.34 27.52 0 0.000 0.000 2.320</pose><uri>model://pickup</uri></include>
    <include><name>s2_hatchback_1</name><pose>162.93 47.96 0 0.000 0.000 -4.634</pose><uri>model://hatchback</uri></include>
    <include><name>cordon_s1_main_street_1</name><pose>-7.16 43.38 0 0.000 0.000 1.790</pose><uri>model://jersey_barrier</uri></include>
    <include><name>cordon_s1_main_street_2</name><pose>-8.08 47.52 0 0.000 0.000 1.790</pose><uri>model://jersey_barrier</uri></include>
    <include><name>cordon_s1_cross_street_1</name><pose>-100.59 8.91 0 0.000 0.000 3.416</pose><uri>model://jersey_barrier</uri></include>
    <include><name>cordon_s1_cross_street_2</name><pose>-104.15 7.91 0 0.000 0.000 3.416</pose><uri>model://jersey_barrier</uri></include>
    <include><name>cordon_s2_track_north_1</name><pose>35.28 8.51 0 0.000 0.000 2.588</pose><uri>model://jersey_barrier</uri></include>
