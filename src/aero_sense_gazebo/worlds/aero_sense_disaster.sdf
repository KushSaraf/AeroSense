    <include><name>s1_building_1</name><pose>-186.72 76.04 0 0.000 0.000 3.185</pose><uri>model://aero_sense_building_apartment_4f_lavender</uri></include>
    <include><name>s1_building_2</name><pose>-19.59 80.18 0 0.000 0.000 3.049</pose><uri>model://aero_sense_building_apartment_4f_lavender</uri></include>
