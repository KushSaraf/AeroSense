<?xml version="1.0"?>
<!--
  GENERATED by aero_sense_description/render.py from config/sensors.yaml (quality: {{ cfg.quality }}).
  Do not edit the output; edit the template or the table.

  Aero Sense hexacopter (ArduPilot Hexa-X) + its payload, each sensor with the real part's field of
  view and Gaussian noise: OAK-D Pro W RGB and stereo depth, FLIR Lepton 3.5 LWIR thermal (all
  55 deg down from one optical centre), the OAK-D's IMU and the flight controller's barometer.
  Rotor aerodynamics (LiftDrag per blade, velocity-controlled joints) are the stock ArduPilot iris's,
  six of them; rotor_<i>_joint is ArduPilot motor i+1 (render.HEXA_X).
-->
{% macro camera_noise(stddev) %}<noise><type>gaussian</type><mean>0</mean><stddev>{{ stddev }}</stddev></noise>{% endmacro %}
{% macro noise(stddev) %}<noise type="gaussian"><mean>0</mean><stddev>{{ stddev }}</stddev></noise>{% endmacro %}
{% set p = cfg.profile %}
{% set af = cfg.airframe %}
<sdf version="1.9">
  <model name="{{ name }}">
    <!-- ================= airframe ================= -->
    <link name="base_link">
      <inertial>
        <mass>{{ af.body_mass_kg }}</mass>
        <inertia><ixx>{{ af.body_inertia[0] }}</ixx><iyy>{{ af.body_inertia[1] }}</iyy><izz>{{ af.body_inertia[2] }}</izz></inertia>
      </inertial>
{% set plates = af.plate_stack_m %}
{% set sk = af.skids %}
      <!-- The frame, from its CAD: plates, arms, motor mounts and landing gear in one mesh. -->
      <visual name="frame">
        <geometry><mesh><uri>file://{{ meshes }}/hexacopter_frame.glb</uri></mesh></geometry>
      </visual>
      <collision name="plates_collision">
        <geometry><box><size>{{ plates | join(' ') }}</size></box></geometry>
      </collision>
      <!-- The skids' end caps are what touch the ground: aero_sense_bringup/worlds.py
           GEAR_HEIGHT_M is their depth below base_link (tested there). -->
{% for side in (1, -1) %}
      <collision name="skid_{{ loop.index0 }}_collision">
        <pose>0 {{ side * sk.y_m }} {{ sk.z_m }} 0 1.5707963 0</pose>
        <geometry><cylinder><radius>{{ sk.radius_m }}</radius><length>{{ sk.length_m }}</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
{% endfor %}
      <!-- Parts without CAD (render.layout): labelled boxes at their published sizes, the battery
           straps, the camera tray hung from the bottom plate, and the wiring. -->
{% for m in parts.meshes %}
      <visual name="{{ m.name }}">
        <pose>{{ m.xyz | join(' ') }} 0 0 {{ m.yaw }}</pose>
        <geometry><mesh><uri>file://{{ meshes }}/{{ m.mesh }}</uri></mesh></geometry>
      </visual>
{% endfor %}
{% for b in parts.boxes %}
      <visual name="{{ b.name }}">
        <pose>{{ b.xyz | join(' ') }} 0 0 0</pose>
        <geometry><box><size>{{ b.size | join(' ') }}</size></box></geometry>
        <material><diffuse>{{ b.rgba }}</diffuse></material>
      </visual>
{% endfor %}
{% for w in parts.wires %}
      <visual name="wire_{{ w.name }}">
        <pose>{{ w.xyz | join(' ') }} {{ w.rpy | join(' ') }}</pose>
        <geometry><cylinder><radius>{{ w.radius }}</radius><length>{{ w.length }}</length></cylinder></geometry>
        <material><diffuse>{{ w.rgba }}</diffuse></material>
      </visual>
{% endfor %}
      <!-- Generic outrunner motors on the frame's motor mounts: stator base, bell, silver band. -->
{% set ml = af.motor_look %}
{% for r in rotors %}
      <visual name="motor_{{ loop.index0 }}_stator">
        <pose>{{ r.xy[0] }} {{ r.xy[1] }} {{ af.motor_mount_top_m + 0.004 }} 0 0 0</pose>
        <geometry><cylinder><radius>{{ ml.diameter_m * 0.42 }}</radius><length>0.008</length></cylinder></geometry>
        <material><diffuse>0.22 0.22 0.24 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
      </visual>
      <visual name="motor_{{ loop.index0 }}_bell">
        <pose>{{ r.xy[0] }} {{ r.xy[1] }} {{ af.motor_mount_top_m + 0.008 + (ml.height_m - 0.008) / 2 }} 0 0 0</pose>
        <geometry><cylinder><radius>{{ ml.diameter_m / 2 }}</radius><length>{{ ml.height_m - 0.008 }}</length></cylinder></geometry>
        <material><diffuse>0.04 0.04 0.05 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="motor_{{ loop.index0 }}_band">
        <pose>{{ r.xy[0] }} {{ r.xy[1] }} {{ af.motor_mount_top_m + ml.height_m - 0.005 }} 0 0 0</pose>
        <geometry><cylinder><radius>{{ ml.diameter_m / 2 + 0.0005 }}</radius><length>0.004</length></cylinder></geometry>
        <material><diffuse>0.75 0.76 0.78 1</diffuse><specular>1 1 1 1</specular></material>
      </visual>
      <visual name="motor_{{ loop.index0 }}_adapter">
        <pose>{{ r.xy[0] }} {{ r.xy[1] }} {{ af.motor_mount_top_m + ml.height_m + 0.005 }} 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.010</length></cylinder></geometry>
        <material><diffuse>0.7 0.71 0.73 1</diffuse><specular>1 1 1 1</specular></material>
      </visual>
{% endfor %}
      <!-- Obstacle-avoidance rangefinders: one beam out of each side (config/sensors.yaml).
           A single-return gpu_lidar is what the part is: one distance along its beam. -->
{% set rf = cfg.rangefinders %}
{% for b in beams %}
{% if not rf.rendered %}
      <visual name="rangefinder_{{ b.name }}">
        <pose>{{ b.pose }}</pose>
        <geometry><mesh><uri>file://{{ meshes }}/{{ b.mesh }}</uri></mesh></geometry>
      </visual>
{% else %}
      <visual name="rangefinder_{{ b.name }}">
        <pose>{{ b.pose }}</pose>
        <geometry><mesh><uri>file://{{ meshes }}/{{ b.mesh }}</uri></mesh></geometry>
      </visual>
      <sensor name="rangefinder_{{ b.name }}" type="gpu_lidar">
        <pose>{{ b.pose }}</pose>
        <gz_frame_id>{{ frames['rangefinder_' ~ b.name] }}</gz_frame_id>
        <topic>{{ topics['rangefinder_' ~ b.name] }}</topic>
        <update_rate>{{ rf.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <!-- The part measures one distance over its beam's divergence, so the beam is a small
             fan of rays and the nearest return is the reading (drone_interface). A single ray
             segfaults gz-rendering 8's Ogre2GpuRays: it has no render target to draw into. -->
        <lidar>
          <scan>
            <horizontal><samples>{{ rf.beam_samples }}</samples><resolution>1</resolution>
              <min_angle>{{ -b.beam_rad / 2 }}</min_angle><max_angle>{{ b.beam_rad / 2 }}</max_angle></horizontal>
            <vertical><samples>{{ rf.beam_samples }}</samples><resolution>1</resolution>
              <min_angle>{{ -b.beam_rad / 2 }}</min_angle><max_angle>{{ b.beam_rad / 2 }}</max_angle></vertical>
          </scan>
          <range><min>{{ rf.range_m[0] }}</min><max>{{ rf.range_m[1] }}</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>{{ rf.noise_stddev }}</stddev></noise>
        </lidar>
      </sensor>
{% endif %}
{% endfor %}
    </link>

    <!-- Flight IMU, read by ArduPilot SITL (noise-free: SITL adds its own sensor model). -->
    <link name="flight_imu_link">
      <inertial>
        <mass>0.15</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name="flight_imu_joint" type="revolute">
      <child>flight_imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>0</upper><effort>0</effort><velocity>0</velocity></limit>
        <dynamics><damping>1.0</damping></dynamics>
      </axis>
    </joint>

{% for r in rotors %}
{% set fwd = 1 if r.spin == "ccw" else -1 %}
    <link name="{{ r.name }}">
      <pose>{{ r.xy[0] }} {{ r.xy[1] }} {{ af.motor_mount_top_m + af.motor_look.height_m + 0.006 }} 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-06</ixx><iyy>0.000166704</iyy><izz>0.000167604</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.1</radius><length>0.005</length></cylinder></geometry>
      </collision>
      <!-- motor {{ r.motor }}, {{ r.spin }} -->
      <visual name="prop">
        <geometry>
          <mesh>
            <uri>package://ardupilot_gazebo/models/iris_with_standoffs/meshes/iris_prop_{{ r.spin }}.dae</uri>
            <scale>{{ af.prop_visual_scale }} {{ af.prop_visual_scale }} 1</scale>
          </mesh>
        </geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="{{ r.name }}_joint" type="revolute">
      <child>{{ r.name }}</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
      </axis>
    </joint>
{% for side in (1, -1) %}
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>0.002</area><air_density>1.2041</air_density>
      <cp>{{ 0.084 * side }} 0 0</cp>
      <forward>0 {{ fwd * side }} 0</forward>
      <upward>0 0 1</upward>
      <link_name>{{ r.name }}</link_name>
    </plugin>
{% endfor %}
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>{{ r.name }}_joint</joint_name>
    </plugin>
{% endfor %}

    <!-- Air drag on the airframe, horizontal, linear in speed: a multirotor's is mostly rotor drag,
         about 0.35 N per m/s for each kg (2.55 kg here). Without it nothing slowed the drone once it
         stopped controlling position: an EKF failsafe landing with no GPS and no vision coasted
         150 m. Gazebo has no plain body-drag system; Hydrodynamics' linear damping is exactly
         this force (no added mass, no current, no buoyancy). -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1.2041</water_density>
      <xU>-{{ cfg.airframe.drag_n_per_mps }}</xU>
      <yV>-{{ cfg.airframe.drag_n_per_mps }}</yV>
      <disable_coriolis>true</disable_coriolis>
      <disable_added_mass>true</disable_added_mass>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <!-- Ground truth for the simulator's own use (GPS jammer, drift scoring), not a drone sensor -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>{{ topics.ground_truth }}</odom_topic>
      <odom_frame>map</odom_frame>
      <robot_base_frame>ground_truth</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>flight_imu_link::imu_sensor</imuName>
{% for r in rotors %}
      <!-- motor {{ r.motor }} ({{ r.spin }}): servo [0, 1] -> motor_max_rad_s, sign = spin direction -->
      <control channel="{{ loop.index0 }}">
        <jointName>{{ r.name }}_joint</jointName>
        <useForce>1</useForce>
        <multiplier>{{ af.motor_max_rad_s if r.spin == "ccw" else -af.motor_max_rad_s }}</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min>
        <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
{% endfor %}
    </plugin>

    <!-- ================= payload ================= -->

    <link name="payload_link">
      <pose>{{ cfg.mount.xyz | join(' ') }} 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz></inertia>
      </inertial>
      <!-- The real cameras, from their manufacturers' CAD (hardware/cad, tools/step_to_mesh.py).
           Each mesh's origin is the centre of its front face, looking along +X. The simulated
           RGB, depth and thermal sensors below share one optical centre (perception fuses them
           pixel for pixel); the Lepton mesh sits beside the OAK-D, 6 cm of parallax the real
           build will calibrate out. -->
      <visual name="oak_d_pro_w">
        <pose>0 0 0 0 {{ cfg.mount.camera_pitch_rad }} 0</pose>
        <geometry><mesh><uri>file://{{ meshes }}/oak_d_pro_w.glb</uri></mesh></geometry>
      </visual>
      <visual name="flir_lepton_3_5">
        <pose>0 {{ cfg.mount.thermal_mesh_offset_y_m }} 0 0 {{ cfg.mount.camera_pitch_rad }} 0</pose>
        <geometry><mesh><uri>file://{{ meshes }}/flir_lepton_3_5.glb</uri></mesh></geometry>
      </visual>

      <sensor name="rgb" type="camera">
        <pose>0 0 0 0 {{ cfg.mount.camera_pitch_rad }} 0</pose>
        <gz_frame_id>{{ frames.camera_optical }}</gz_frame_id>
        <topic>{{ topics.rgb }}</topic>
        <update_rate>{{ p.rgb.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>{{ topics.rgb_info }}</camera_info_topic>
          <horizontal_fov>{{ cfg.rgb.hfov_rad }}</horizontal_fov>
          <image><width>{{ p.rgb.width }}</width><height>{{ p.rgb.height }}</height><format>R8G8B8</format></image>
          <clip><near>{{ cfg.rgb.clip_m[0] }}</near><far>{{ cfg.rgb.clip_m[1] }}</far></clip>
          {{ camera_noise(cfg.rgb.noise_stddev) }}
        </camera>
      </sensor>

      <sensor name="depth" type="depth_camera">
        <pose>0 0 0 0 {{ cfg.mount.camera_pitch_rad }} 0</pose>
        <gz_frame_id>{{ frames.camera_optical }}</gz_frame_id>
        <topic>{{ topics.depth }}</topic>
        <update_rate>{{ p.depth.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>{{ topics.depth_info }}</camera_info_topic>
          <horizontal_fov>{{ cfg.depth.hfov_rad }}</horizontal_fov>
          <image><width>{{ p.depth.width }}</width><height>{{ p.depth.height }}</height><format>R_FLOAT32</format></image>
          <clip><near>{{ cfg.depth.clip_m[0] }}</near><far>{{ cfg.depth.clip_m[1] }}</far></clip>
          {{ camera_noise(cfg.depth.noise_stddev) }}
        </camera>
      </sensor>

{% for cam, y in stereo.items() %}
      <!-- OAK-D Pro W stereo {{ cam.split('_')[1] }} (OV9282, global shutter mono): what VIO tracks -->
      <sensor name="{{ cam }}" type="camera">
        <pose>0 {{ y }} 0 0 {{ cfg.mount.camera_pitch_rad }} 0</pose>
        <gz_frame_id>{{ frames[cam ~ '_optical'] }}</gz_frame_id>
        <topic>{{ topics[cam] }}</topic>
        <update_rate>{{ p.stereo.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>{{ topics[cam ~ '_info'] }}</camera_info_topic>
          <horizontal_fov>{{ cfg.stereo.hfov_rad }}</horizontal_fov>
          <image><width>{{ p.stereo.width }}</width><height>{{ p.stereo.height }}</height><format>L8</format></image>
          <clip><near>{{ cfg.stereo.clip_m[0] }}</near><far>{{ cfg.stereo.clip_m[1] }}</far></clip>
          {{ camera_noise(cfg.stereo.noise_stddev) }}
        </camera>
      </sensor>

{% endfor %}
      <sensor name="thermal" type="thermal">
        <pose>0 0 0 0 {{ cfg.mount.camera_pitch_rad }} 0</pose>
        <gz_frame_id>{{ frames.camera_optical }}</gz_frame_id>
        <topic>{{ topics.thermal }}</topic>
        <update_rate>{{ cfg.thermal.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>{{ topics.thermal_info }}</camera_info_topic>
          <horizontal_fov>{{ cfg.thermal.hfov_rad }}</horizontal_fov>
          <image><width>{{ cfg.thermal.width }}</width><height>{{ cfg.thermal.height }}</height><format>L16</format></image>
          <clip><near>{{ cfg.thermal.clip_m[0] }}</near><far>{{ cfg.thermal.clip_m[1] }}</far></clip>
          <!-- No <noise>: gz-sensors 8 ThermalCameraSensor passes it to the non-image NoiseFactory,
               gets null back and segfaults the server. -->
        </camera>
        <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
          <min_temp>{{ cfg.thermal.temp_range_k[0] }}</min_temp>
          <max_temp>{{ cfg.thermal.temp_range_k[1] }}</max_temp>
          <resolution>{{ cfg.thermal.resolution_k }}</resolution>
        </plugin>
      </sensor>

      <sensor name="imu" type="imu">
        <gz_frame_id>{{ frames.imu_link }}</gz_frame_id>
        <topic>{{ topics.imu }}</topic>
        <update_rate>{{ cfg.imu.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
{% for axis in "xyz" %}
            <{{ axis }}>{{ noise(cfg.imu.gyro_stddev) }}</{{ axis }}>
{% endfor %}
          </angular_velocity>
          <linear_acceleration>
{% for axis in "xyz" %}
            <{{ axis }}>{{ noise(cfg.imu.accel_stddev) }}</{{ axis }}>
{% endfor %}
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="baro" type="air_pressure">
        <gz_frame_id>{{ frames.baro_link }}</gz_frame_id>
        <topic>{{ topics.baro }}</topic>
        <update_rate>{{ cfg.baro.rate_hz }}</update_rate>
        <always_on>1</always_on>
        <air_pressure>
          <reference_altitude>0</reference_altitude>
          <pressure>{{ noise(cfg.baro.noise_stddev) }}</pressure>
        </air_pressure>
      </sensor>
    </link>

    <joint name="payload_joint" type="fixed">
      <parent>base_link</parent>
      <child>payload_link</child>
    </joint>
  </model>
</sdf>
