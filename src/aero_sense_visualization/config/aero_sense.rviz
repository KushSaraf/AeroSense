Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 40
      Color: 100; 100; 100
      Alpha: 0.3
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 8
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/Pose
      Name: Drone
      Enabled: true
      Topic:
        Value: /aero_sense/drone/pose
        Depth: 5
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 6
      Axes Radius: 0.8
    - Class: rviz_default_plugins/MarkerArray
      Name: Victims found
      Enabled: true
      Topic:
        Value: /aero_sense/visualization/victims
        Depth: 10
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Ground truth (evaluation only)
      Enabled: true
      Topic:
        Value: /aero_sense/visualization/ground_truth
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /aero_sense/lidar/points
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.4
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Image
      Name: RGB camera
      Enabled: true
      Topic:
        Value: /aero_sense/camera/rgb/image_raw
        Depth: 2
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Thermal camera
      Enabled: true
      Topic:
        Value: /aero_sense/camera/thermal/image_raw
        Depth: 2
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Depth camera
      Enabled: false
      Topic:
        Value: /aero_sense/camera/depth/image_raw
        Depth: 2
        Reliability Policy: Best Effort
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 260
      Focal Point:
        X: -80
        Y: 40
        Z: 0
      Pitch: 0.9
      Yaw: 1.2
      Target Frame: map
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1700
  Displays:
    collapsed: false
